{
  "name": "besnovatyj/yii2-cms-file",
  "description": "Модуль управления файлами для Yii2 CMS",
  "version": "1.0.0",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\File\\Module",
    "moduleId": "File",
    "bescms": { "kind": "module" }
  },
  "keywords": [
    "yii2",
    "file",
    "cms"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "yiisoft/yii2": "~2.0.0",
    "yiisoft/yii2-bootstrap5": "~2.0.0",
    "league/flysystem": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "league/flysystem-ziparchive": "^3.0",
    "besnovatyj/yii2-cms-ckeditor5": "^1.0",
    "besnovatyj/yii2-cms-file-manager": "~1.0.0",
    "besnovatyj/ckeditor5-filemanager": "^1.0",
    "besnovatyj/ckeditor5-codemirror": "^1.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\File\\": "src/"
    }
  }
}
